# ==============================================================================
# MAYOTIX OS - Hardened Kernel WireGuard Client Configuration Template
# Profile: Interface Pinned with System-wide Kill-Switch (wg0-pinned)
# ==============================================================================
# Security Standard: Hardened Egress Pinning & Strict Leak Prevention
# Features:
#   - Pinned physical interface binding (FwMark / Egress table isolation)
#   - Automatic nftables / iptables kill-switch on tunnel bring-up
#   - Blocks non-tunnel IPv4/IPv6 traffic during active tunnel session
#   - Drops all unencrypted egress on interface disconnection
# Permissions: Must be chmod 0600 and owned by root:root
# ==============================================================================

[Interface]
# Client private key (Curve25519)
PrivateKey = {{CLIENT_PRIVATE_KEY}}

# Client tunnel IPv4 and IPv6 addresses
Address = {{CLIENT_IPV4_ADDRESS}}/32, {{CLIENT_IPV6_ADDRESS}}/128

# Systemd-resolved DNS-over-TLS stub pointer
DNS = 127.0.0.53

# Tunnel MTU
MTU = 1420

# Firewall Mark for routing table isolation
FwMark = 0x51820

# Strict Routing Table
Table = auto

# ------------------------------------------------------------------------------
# System-wide Kill-Switch PostUp / PostDown firewall hooks (nftables / iptables)
# Prevents any packet from leaking out physical interfaces if VPN is compromised or drops
# ------------------------------------------------------------------------------
PostUp = iptables -I OUTPUT ! -o %i -m mark ! --mark 0x51820 -m addrtype ! --dst-type LOCAL -j REJECT; ip6tables -I OUTPUT ! -o %i -m mark ! --mark 0x51820 -m addrtype ! --dst-type LOCAL -j REJECT
PostDown = iptables -D OUTPUT ! -o %i -m mark ! --mark 0x51820 -m addrtype ! --dst-type LOCAL -j REJECT; ip6tables -D OUTPUT ! -o %i -m mark ! --mark 0x51820 -m addrtype ! --dst-type LOCAL -j REJECT

[Peer]
# Server public key
PublicKey = {{SERVER_PUBLIC_KEY}}

# Pre-shared Key (Optional symmetric key overlay)
# PresharedKey = {{PRESHARED_KEY}}

# Server VPN gateway endpoint
Endpoint = {{SERVER_ENDPOINT_IP}}:{{SERVER_ENDPOINT_PORT}}

# Full tunnel routing
AllowedIPs = 0.0.0.0/0, ::/0

# Persistent Keepalive (25 seconds)
PersistentKeepalive = 25
