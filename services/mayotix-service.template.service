#!/bin/bash
# MAYOTIX OS Phase 2 Systemd Service Hardening Template
#
# Base service template with 27+ hardening directives
# Copy this as a starting point for all MAYOTIX services
#
# Usage:
#   1. Create service: cp mayotix-service.template.service /etc/systemd/system/mayotix-foo.service
#   2. Edit ExecStart and other service-specific fields
#   3. Reload: systemctl daemon-reload
#   4. Start: systemctl start mayotix-foo.service
#   5. Verify: systemd-analyze security mayotix-foo.service

[Unit]
Description=MAYOTIX Custom Service
Documentation=man:mayotix(1) https://mayotix.os/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

### Execution
ExecStart=/usr/libexec/mayotix-service-executable
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s

### Privileges & Capabilities
User=mayotix
Group=mayotix
NoNewPrivileges=yes
PrivateUsers=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=
SecureBits=keep-caps keep-caps-locked nosetuid-fixed nosetuid-fixed-locked no-cap-ambient-raise no-cap-ambient-raise-locked

### Filesystem Isolation
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/mayotix
ReadOnlyPaths=/etc /usr /lib
TemporaryFileSystem=/tmp:size=512M:nodev,noexec,nosuid

### Process Isolation
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateIPC=yes

### System Call Filtering (seccomp)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
SystemCallErrorNumber=EPERM
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap @system-service @tracing

### Resource Limits
LimitNOFILE=65535
LimitNPROC=512
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
IOAccounting=yes

### Logging & Audit
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mayotix-service

### Device Access
PrivateDevices=yes
DevicePolicy=closed

### Runtime & State Directories
RuntimeDirectory=mayotix
RuntimeDirectoryMode=0755
StateDirectory=mayotix
StateDirectoryMode=0700

### Configuration
EnvironmentFile=-/etc/default/%n
EnvironmentFile=-/etc/mayotix/service.conf

[Install]
WantedBy=multi-user.target
