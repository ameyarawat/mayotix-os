# MAYOTIX OS Hardened Service Template
# This template applies the 27+ systemd hardening directives
# Services should inherit from this template using .include

[Unit]
Description=%i Service
Documentation=man:%i(1) https://mayotix.os/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%i
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=3

# Process management
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSigKill=yes

# User/Group (should be overridden per service)
User=%i
Group=%i

# Security isolation - Filesystem (27+ directives)
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
PrivateUsers=no
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

# Capabilities and privileges
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=
SecureBits=keep-caps keep-caps-locked nosetuid-fixed nosetuid-fixed-locked no-cap-ambient-raise no-cap-ambient-raise-locked

# System call filtering
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
SystemCallErrorNumber=EPERM
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap @system-service @tracing

# Resource limits
LimitNOFILE=65535
LimitNPROC=512

# Cgroup management
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
IOAccounting=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=%i

# Device access
PrivateDevices=yes
DevicePolicy=closed

# Read-only paths
ReadOnlyPaths=/sys /proc /dev/null

# Temporary directory
PrivateTmp=yes
TemporaryFileSystem=/tmp:size=1G:nodev,noexec,nosuid

# Environment
EnvironmentFile=-/etc/default/%i
EnvironmentFile=-/etc/mayotix/security.conf

[Install]
WantedBy=multi-user.target