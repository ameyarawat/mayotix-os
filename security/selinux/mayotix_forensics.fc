# MAYOTIX OS Phase 7: Forensics & Memory Extraction SELinux File Contexts

/usr/local/sbin/mayotix-dump           -- gen_context(system_u:object_r:mayotix_forensics_exec_t,s0)
/usr/share/mayotix/defender/forensics(/.*)? gen_context(system_u:object_r:mayotix_forensics_exec_t,s0)
/var/log/mayotix/forensics(/.*)?          gen_context(system_u:object_r:mayotix_forensics_log_t,s0)
