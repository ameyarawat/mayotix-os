module mayotix_vm 1.0;

require {
    type unconfined_t;
    type bin_t;
    type lib_t;
    type etc_t;
    type var_t;
    type var_log_t;
    type var_lib_t;
    type tmp_t;
    type devpts_t;
    type proc_t;
    type net_conf_t;
    type node_t;
    type kvm_device_t;
    type tun_tap_device_t;
    class file { create read write open execute execute_no_trans unlink getattr entrypoint map relabelfrom relabelto };
    class dir { search open read write add_name remove_name getattr rmdir };
    class process { transition siginh rlimitinh noatsecure signal getsched setsched setpgid fork getattr ptrace };
    class capability { setuid setgid sys_admin net_admin dac_override sys_resource ipc_lock };
    class chr_file { read write open getattr ioctl };
    class fifo_file { read write getattr };
    class tun_socket { create bind setopt getattr read write relabelfrom relabelto };
    class udp_socket { create bind setopt getattr read write };
    class tcp_socket { create bind setopt getattr read write listen accept };
    class netlink_route_socket { create bind read write nlmsg_read nlmsg_write };
}

# Define VM domain, execution, image, and log types
type mayotix_vm_t;
type mayotix_vm_exec_t;
type mayotix_vm_image_t;
type mayotix_vm_log_t;

# Process entrypoint
allow mayotix_vm_t self:process { signal getsched setsched setpgid fork getattr ptrace };
allow mayotix_vm_t mayotix_vm_exec_t:file { entrypoint read open execute getattr map };

# Transition from unconfined admin
type_transition unconfined_t mayotix_vm_exec_t:process mayotix_vm_t;
allow unconfined_t mayotix_vm_t:process { transition siginh rlimitinh noatsecure };
allow unconfined_t mayotix_vm_exec_t:file { read open execute getattr };

# Bounded capabilities for KVM hardware acceleration and TAP networking
allow mayotix_vm_t self:capability { setuid setgid sys_admin net_admin dac_override sys_resource ipc_lock };

# Hardware virtualization access (/dev/kvm)
allow mayotix_vm_t kvm_device_t:chr_file { read write open getattr ioctl };

# TAP device virtualization (/dev/net/tun)
allow mayotix_vm_t tun_tap_device_t:chr_file { read write open getattr ioctl };
allow mayotix_vm_t self:tun_socket { create bind setopt getattr read write relabelfrom relabelto };

# Virtual network bridge sockets
allow mayotix_vm_t self:udp_socket { create bind setopt getattr read write };
allow mayotix_vm_t self:tcp_socket { create bind setopt getattr read write listen accept };
allow mayotix_vm_t self:netlink_route_socket { create bind read write nlmsg_read nlmsg_write };
allow mayotix_vm_t net_conf_t:file { read open getattr };

# System binaries & libraries
allow mayotix_vm_t bin_t:file { read open execute execute_no_trans getattr map };
allow mayotix_vm_t lib_t:file { read open execute getattr map };
allow mayotix_vm_t etc_t:file { read open getattr };
allow mayotix_vm_t etc_t:dir { search open getattr };
allow mayotix_vm_t proc_t:dir { search open read getattr };
allow mayotix_vm_t proc_t:file { read open getattr };

# Dedicated VM image storage under /var/lib/mayotix/vms/
allow mayotix_vm_t var_t:dir { search open getattr };
allow mayotix_vm_t var_lib_t:dir { search open getattr };
allow mayotix_vm_t mayotix_vm_image_t:dir { search open read write add_name remove_name getattr rmdir };
allow mayotix_vm_t mayotix_vm_image_t:file { create read write open unlink getattr rename map };

# Confined logging under /var/log/mayotix/vms/
allow mayotix_vm_t var_log_t:dir { search open getattr };
allow mayotix_vm_t mayotix_vm_log_t:dir { search open read write add_name remove_name getattr rmdir };
allow mayotix_vm_t mayotix_vm_log_t:file { create read write open unlink getattr map };

# Ephemeral scratch tmpfs
allow mayotix_vm_t tmp_t:dir { create search open read write add_name remove_name getattr rmdir };
allow mayotix_vm_t tmp_t:file { create read write open unlink getattr rename map };
allow mayotix_vm_t devpts_t:chr_file { read write open getattr ioctl };

# NOTE: Real host user home directories (user_home_t) are EXPLICITLY OMITTED
# to preserve absolute airgap containment and prevent virtual machine breakout into user files.
