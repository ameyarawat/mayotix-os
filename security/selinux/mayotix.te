module mayotix 1.0;

########################################
#
# Declarations
#
########################################

require {
    type unconfined_t;
    type init_t;
    type auditd_t;
    type fs_t;
    type proc_t;
    type sysfs_t;
    type device_t;
    type var_log_t;
    type tmp_t;
    type etc_t;
    type bin_t;
    type lib_t;
    type var_lib_t;
    class file { create read write open execute execute_no_trans unlink link rename append getattr };
    class dir { search add_name remove_name create write read open getattr };
    class process { siginh noatsecure rlimitinh setrlimit transition signal };
    class capability { sys_admin sys_tty_config sys_resource };
    class unix_stream_socket { create connectto };
    class unix_dgram_socket { create sendto };
    class tcp_socket { create name_bind name_connect };
    class udp_socket { create name_bind name_connect };
    class chr_file { read write open };
    class blk_file { read write open };
    class fd { use };
}

# MAYOTIX custom types
type mayotix_t;
type mayotix_exec_t;
type mayotix_lib_t;
type mayotix_var_lib_t;
type mayotix_etc_t;
type mayotix_log_t;
type mayotix_tmp_t;
type mayotix_dev_t;
type mayotix_kernel_t;

########################################
#
# Domain transitions
#
########################################

# Allow transition from init/unconfined to mayotix domain
type_transition unconfined_t mayotix_exec_t:process mayotix_t;
type_transition init_t mayotix_exec_t:process mayotix_t;

########################################
#
# mayotix_t local policy
#
########################################

# Execute MAYOTIX binaries
allow mayotix_t mayotix_exec_t:file { execute execute_no_trans read open getattr };
allow mayotix_t mayotix_lib_t:file { read open getattr };

# Read/write var/lib for state data
allow mayotix_t mayotix_var_lib_t:dir { search add_name remove_name create write read open };
allow mayotix_t mayotix_var_lib_t:file { create read write open unlink link rename getattr };

# Read configuration files
allow mayotix_t mayotix_etc_t:dir { search read open };
allow mayotix_t mayotix_etc_t:file { read open getattr };

# Write to log files
allow mayotix_t mayotix_log_t:dir { search add_name };
allow mayotix_t mayotix_log_t:file { create write open append getattr };

# Temporary files
allow mayotix_t mayotix_tmp_t:dir { search add_name remove_name };
allow mayotix_t mayotix_tmp_t:file { create read write open unlink link rename getattr };

# Read kernel modules/configs
allow mayotix_t mayotix_kernel_t:dir { search read open };
allow mayotix_t mayotix_kernel_t:file { read open getattr };

# Device access (restricted)
allow mayotix_t mayotix_dev_t:chr_file { read write open };
allow mayotix_t mayotix_dev_t:blk_file { read write open };

########################################
#
# Process and capability rules
#
########################################

allow mayotix_t self:capability { sys_admin sys_tty_config sys_resource };
allow mayotix_t self:process { siginh noatsecure rlimitinh setrlimit };
allow mayotix_t self:unix_stream_socket { create connectto };
allow mayotix_t self:unix_dgram_socket { create sendto };

# Network access (controlled)
allow mayotix_t self:tcp_socket { create name_bind name_connect };
allow mayotix_t self:udp_socket { create name_bind name_connect };

# Audit logging
allow mayotix_t auditd_t:fd { use };