def cmd_status(args):
    data = query_subsystem("status.get", sock_path=args.socket)
    if args.json:
        print(json.dumps(data, indent=2))
        return 0

    print(f"\n{BOLD}{CYAN}================================================================{NC}")
    print(f"{BOLD}{CYAN}                 MAYOTIX OS System Status                       {NC}")
    print(f"{BOLD}{CYAN}================================================================{NC}")
    print(f"  {BOLD}Operating System:{NC} {data.get('os', 'MAYOTIX OS')} {data.get('version', '')}")
    print(f"  {BOLD}Security Score:{NC}   {GREEN}{data.get('security_score', 100)}/100 (Pass - Compliant){NC}")
    print(f"\n  {BOLD}Subsystems Overview:{NC}")
    sub = data.get("subsystems", {})
    for k, v in sub.items():
        name = k.replace("_", " ").title()
        status_color = GREEN if "Active" in v or "Enforcing" in v or "Connected" in v or "Enabled" in v else YELLOW
        print(f"    - {name:<18} : {status_color}{v}{NC}")
    print(f"{BOLD}{CYAN}================================================================{NC}\n")
    return 0

