def main():
    common_parser = argparse.ArgumentParser(add_help=False)
    common_parser.add_argument("--json", action="store_true", help="Output results strictly formatted as JSON")
    common_parser.add_argument("--socket", default=DEFAULT_SOCKET_PATH, help="Path to mayotix-daemon Unix domain socket")

    parser = argparse.ArgumentParser(
        prog="mayotix",
        parents=[common_parser],
        description="MAYOTIX OS Unified System Management CLI",
        epilog="Use 'mayotix <command> --help' for details on specific subcommands."
    )

    subparsers = parser.add_subparsers(dest="command", help="Management command to execute")

    # mayotix status
    p_status = subparsers.add_parser("status", parents=[common_parser], help="Display overall system and security posture")
    p_status.set_defaults(func=cmd_status)

    # mayotix security
    p_sec = subparsers.add_parser("security", parents=[common_parser], help="Inspect SELinux mode, policies, and kernel hardening")
    p_sec.set_defaults(func=cmd_security)

    # mayotix network
    p_net = subparsers.add_parser("network", parents=[common_parser], help="Inspect Encrypted DNS, WireGuard VPN, and Tor privacy status")
    p_net.set_defaults(func=cmd_network)

    # mayotix firewall
    p_fw = subparsers.add_parser("firewall", parents=[common_parser], help="Inspect and control nftables fail-closed kill-switch")
    p_fw.add_argument("--enable", action="store_true", help="Atomically enable fail-closed kill-switch")
    p_fw.add_argument("--disable", action="store_true", help="Disable kill-switch and restore default policy")
    p_fw.set_defaults(func=cmd_firewall)

    # mayotix capture
    p_cap = subparsers.add_parser("capture", parents=[common_parser], help="Manage defender live packet captures and security sniffing")
    p_cap.add_argument("--dry-run", action="store_true", help="Simulate capture status/operation")
    cap_subparsers = p_cap.add_subparsers(dest="capture_action", help="Capture action to perform")

    p_cap_start = cap_subparsers.add_parser("start", parents=[common_parser], help="Start packet capture session")
    p_cap_start.add_argument("-i", "--interface", help="Target network interface (e.g., wg0, eth0, any)")
    p_cap_start.add_argument("-p", "--profile", default="wireguard-egress", help="Capture profile (wireguard-egress, dot-dns, leak-sniffer, custom)")
    p_cap_start.add_argument("-f", "--filter", help="Custom BPF filter expression")
    p_cap_start.add_argument("-o", "--output", help="Destination pcap file path")
    p_cap_start.add_argument("--dry-run", action="store_true", help="Simulate capture startup without launching daemon")
    p_cap_start.set_defaults(func=cmd_capture)

    p_cap_stop = cap_subparsers.add_parser("stop", parents=[common_parser], help="Stop active packet capture session")
    p_cap_stop.add_argument("--dry-run", action="store_true", help="Simulate capture stop")
    p_cap_stop.set_defaults(func=cmd_capture)

    p_cap_status = cap_subparsers.add_parser("status", parents=[common_parser], help="Display active packet capture status")
    p_cap_status.add_argument("--dry-run", action="store_true", help="Simulate status check")
    p_cap_status.set_defaults(func=cmd_capture)

    p_cap_profiles = cap_subparsers.add_parser("list-profiles", parents=[common_parser], help="List available security capture profiles")
    p_cap_profiles.set_defaults(func=cmd_capture)

    p_cap.set_defaults(func=cmd_capture)

    # mayotix pcap
    p_pcap = subparsers.add_parser("pcap", parents=[common_parser], help="Automated PCAP threat analysis and sandboxed dissection")
    p_pcap.add_argument("--dry-run", action="store_true", help="Simulate PCAP operation")
    pcap_subparsers = p_pcap.add_subparsers(dest="pcap_action", help="PCAP action to perform")

    p_pcap_scan = pcap_subparsers.add_parser("scan", parents=[common_parser], help="Automated threat & security heuristic scan")
    p_pcap_scan.add_argument("pcap_file", nargs="?", default="", help="Path to PCAP file")
    p_pcap_scan.add_argument("--dry-run", action="store_true", help="Simulate threat analysis on mock capture")
    p_pcap_scan.set_defaults(func=cmd_analyze)

    p_pcap_analyze = pcap_subparsers.add_parser("analyze", parents=[common_parser], help="Alias for pcap scan")
    p_pcap_analyze.add_argument("pcap_file", nargs="?", default="", help="Path to PCAP file")
    p_pcap_analyze.add_argument("--dry-run", action="store_true", help="Simulate analyze")
    p_pcap_analyze.set_defaults(func=cmd_analyze)

    p_pcap_dissect = pcap_subparsers.add_parser("dissect", parents=[common_parser], help="Sandboxed dissection")
    p_pcap_dissect.add_argument("pcap_file", nargs="?", default="", help="Path to PCAP file")
    p_pcap_dissect.add_argument("-s", "--summary", action="store_true", help="Display packet summary")
    p_pcap_dissect.add_argument("-f", "--filter", help="Filter expression")
    p_pcap_dissect.add_argument("-t", "--tool", default="tshark", help="Tool")
    p_pcap_dissect.add_argument("-c", "--count", type=int, help="Packet count")
    p_pcap_dissect.add_argument("--dry-run", action="store_true", help="Simulate sandboxed dissection")
    p_pcap_dissect.set_defaults(func=cmd_dissect)

    p_pcap.set_defaults(func=cmd_analyze)

    # mayotix analyze
    p_ana = subparsers.add_parser("analyze", parents=[common_parser], help="Automated threat & security heuristic analysis of PCAP capture")
    p_ana.add_argument("pcap_file", nargs="?", default="", help="Path to PCAP file to analyze")
    p_ana.add_argument("--dry-run", action="store_true", help="Simulate threat analysis on mock capture")
    p_ana.set_defaults(func=cmd_analyze)

    # mayotix dissect
    p_dis = subparsers.add_parser("dissect", parents=[common_parser], help="Execute sandboxed PCAP dissector inside Bubblewrap container")
    p_dis.add_argument("pcap_file", nargs="?", default="", help="Path to PCAP file to dissect")
    p_dis.add_argument("-s", "--summary", action="store_true", help="Display packet summary and protocol breakdown")
    p_dis.add_argument("-f", "--filter", help="Filter expression (display filter or BPF)")
    p_dis.add_argument("-t", "--tool", default="tshark", help="Dissector tool ('tshark' or 'tcpdump')")
    p_dis.add_argument("-c", "--count", type=int, help="Maximum number of packets to dissect")
    p_dis.add_argument("--dry-run", action="store_true", help="Simulate sandboxed dissection")
    p_dis.set_defaults(func=cmd_dissect)

    # mayotix forensic
    p_forensic = subparsers.add_parser("forensic", parents=[common_parser], help="Volatile process memory extraction and artifact sanitization")
    forensic_subparsers = p_forensic.add_subparsers(dest="forensic_action", help="Forensic action to perform")

    p_for_dump = forensic_subparsers.add_parser("dump", parents=[common_parser], help="Acquire process memory dump and volatile artifacts")
    p_for_dump.add_argument("-p", "--pid", type=int, required=True, help="Target process ID to inspect")
    p_for_dump.add_argument("-o", "--output", help="Destination dump file path")
    p_for_dump.add_argument("-s", "--sanitize", action="store_true", help="Automatically scrub sensitive secrets")
    p_for_dump.add_argument("--dry-run", action="store_true", help="Simulate memory dump acquisition")
    p_for_dump.set_defaults(func=cmd_forensic)

    p_for_san = forensic_subparsers.add_parser("sanitize", parents=[common_parser], help="Scrub credentials and private keys from dump artifact")
    p_for_san.add_argument("dump_file", nargs="?", default="", help="Path to dump artifact to sanitize")
    p_for_san.add_argument("-o", "--output", help="Destination sanitized dump file")
    p_for_san.add_argument("--dry-run", action="store_true", help="Simulate redaction on mock secrets")
    p_for_san.set_defaults(func=cmd_forensic)

    p_forensic.set_defaults(func=cmd_forensic)

    # mayotix monitor
    p_mon = subparsers.add_parser("monitor", parents=[common_parser], help="Live runtime threat and process behavioral monitor")
    p_mon.add_argument("--threats-only", action="store_true", help="Only output alerts when active threats are detected")
    p_mon.add_argument("--interval", type=int, default=0, help="Continuous polling interval in seconds")
    p_mon.add_argument("--dry-run", action="store_true", help="Simulate runtime threat monitoring")
    p_mon.set_defaults(func=cmd_monitor)

    # mayotix lab
    p_lab = subparsers.add_parser("lab", parents=[common_parser], help="Manage isolated disposable analysis sandboxes")
    p_lab.add_argument("--dry-run", action="store_true", help="Simulate lab action")
    lab_subparsers = p_lab.add_subparsers(dest="lab_action", help="Lab action to perform")

    p_lab_launch = lab_subparsers.add_parser("launch", parents=[common_parser], help="Launch an isolated lab sandbox")
    p_lab_launch.add_argument("-n", "--name", help="Session ID / name")
    p_lab_launch.add_argument("-t", "--template", default="base", help="Lab template (base, malware, forensics, network)")
    p_lab_launch.add_argument("--network", default="none", help="Network mode (none, bridge)")
    p_lab_launch.add_argument("--dry-run", action="store_true", help="Simulate lab launch")
    p_lab_launch.set_defaults(func=cmd_lab)

    p_lab_list = lab_subparsers.add_parser("list", parents=[common_parser], help="List active lab sandboxes")
    p_lab_list.add_argument("--dry-run", action="store_true", help="Simulate lab listing")
    p_lab_list.set_defaults(func=cmd_lab)

    p_lab_destroy = lab_subparsers.add_parser("destroy", parents=[common_parser], help="Destroy an active lab sandbox")
    p_lab_destroy.add_argument("lab_id", nargs="?", default="mock-lab", help="Target lab session ID")
    p_lab_destroy.add_argument("--dry-run", action="store_true", help="Simulate lab destruction")
    p_lab_destroy.set_defaults(func=cmd_lab)

    p_lab_status = lab_subparsers.add_parser("status", parents=[common_parser], help="Display lab subsystem status")
    p_lab_status.add_argument("--dry-run", action="store_true", help="Simulate lab status")
    p_lab_status.set_defaults(func=cmd_lab)

    p_lab.set_defaults(func=cmd_lab)

    # mayotix incident
    p_inc = subparsers.add_parser("incident", parents=[common_parser], help="Automated incident response triage and reporting")
    p_inc.add_argument("--dry-run", action="store_true", help="Simulate incident action")
    inc_subparsers = p_inc.add_subparsers(dest="incident_action", help="Incident action to perform")

    p_inc_triage = inc_subparsers.add_parser("triage", parents=[common_parser], help="Capture automated host triage snapshot")
    p_inc_triage.add_argument("-o", "--output", help="Destination path for triage archive")
    p_inc_triage.add_argument("--dry-run", action="store_true", help="Simulate triage capture")
    p_inc_triage.set_defaults(func=cmd_incident)

    p_inc_report = inc_subparsers.add_parser("report", parents=[common_parser], help="List collected incident triage archives")
    p_inc_report.add_argument("--dry-run", action="store_true", help="Simulate triage reporting")
    p_inc_report.set_defaults(func=cmd_incident)

    p_inc.set_defaults(func=cmd_incident)

    # mayotix version
    p_ver = subparsers.add_parser("version", parents=[common_parser], help="Display version and release information")
    p_ver.set_defaults(func=cmd_version)

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 0

    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
