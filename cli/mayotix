def cmd_firewall(args):
    if args.enable:
        res = query_subsystem("firewall.set_killswitch", {"state": "enable"}, sock_path=args.socket)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"{GREEN}[✓]{NC} Fail-closed network kill-switch enabled.")
        return 0
    elif args.disable:
        res = query_subsystem("firewall.set_killswitch", {"state": "disable"}, sock_path=args.socket)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"{YELLOW}[WARN]{NC} Fail-closed network kill-switch disabled.")
        return 0

    data = query_subsystem("firewall.get", sock_path=args.socket)
    if args.json:
        print(json.dumps(data, indent=2))
        return 0

    print(f"\n{BOLD}{CYAN}================================================================{NC}")
    print(f"{BOLD}{CYAN}               MAYOTIX OS Firewall & Kill-Switch                {NC}")
    print(f"{BOLD}{CYAN}================================================================{NC}")
    print(f"  {BOLD}Subsystem:{NC}             {data.get('subsystem', 'nftables')}")
    ks = data.get("killswitch_active", False)
    print(f"  {BOLD}Fail-Closed Killswitch:{NC} {GREEN + 'ENABLED' if ks else YELLOW + 'STANDBY'}{NC}")
    pol = data.get("default_policies", {})
    print(f"  {BOLD}Default Hook Policies:{NC}  INPUT={pol.get('input')} | FORWARD={pol.get('forward')} | OUTPUT={pol.get('output')}")
    cnt = data.get("counters", {})
    print(f"  {BOLD}Cleartext Drops:{NC}        {cnt.get('dropped_output_cleartext', 0)} egress packets blocked")
    print(f"{BOLD}{CYAN}================================================================{NC}\n")
    return 0

def cmd_capture(args):
    capture_script = Path(__file__).resolve().parent.parent / "desktop/defender/mayotix-capture.sh"
    if not capture_script.exists():
        capture_script = Path("/usr/local/sbin/mayotix-capture")

    base_cmd = [str(capture_script)]
    if sys.platform == "win32":
        for git_bash in [
            r"C:\Program Files\Git\bin\bash.exe",
            r"C:\Program Files\Git\usr\bin\bash.exe",
        ]:
            if os.path.exists(git_bash):
                base_cmd = [git_bash, str(capture_script)]
                break
    elif not os.access(str(capture_script), os.X_OK):
        base_cmd = ["/bin/bash", str(capture_script)]

    action = getattr(args, "capture_action", None) or "status"

    if action == "start":
        cmd = list(base_cmd) + ["start"]
        if getattr(args, "interface", None):
            cmd.extend(["--interface", args.interface])
        if getattr(args, "profile", None):
            cmd.extend(["--profile", args.profile])
        if getattr(args, "filter", None):
            cmd.extend(["--filter", args.filter])
        if getattr(args, "output", None):
            cmd.extend(["--output", args.output])
        if getattr(args, "dry_run", False):
            cmd.append("--dry-run")
        res = subprocess.run(cmd, capture_output=True, text=True)
        if getattr(args, "json", False):
            print(json.dumps({"success": res.returncode == 0, "action": "start", "output": res.stdout.strip() or res.stderr.strip()}))
        else:
            print(res.stdout.strip() or res.stderr.strip())
        return res.returncode
    elif action == "stop":
        cmd = list(base_cmd) + ["stop"]
        if getattr(args, "dry_run", False):
            cmd.append("--dry-run")
        res = subprocess.run(cmd, capture_output=True, text=True)
        if getattr(args, "json", False):
            print(json.dumps({"success": res.returncode == 0, "action": "stop", "output": res.stdout.strip() or res.stderr.strip()}))
        else:
            print(res.stdout.strip() or res.stderr.strip())
        return res.returncode
    elif action == "list-profiles":
        cmd = list(base_cmd) + ["list-profiles"]
        res = subprocess.run(cmd, capture_output=True, text=True)
        print(res.stdout.strip() or res.stderr.strip())
        return res.returncode
    else:
        # status
        cmd = list(base_cmd) + ["status"]
        if getattr(args, "json", False):
            cmd.append("--json")
        if getattr(args, "dry_run", False):
            cmd.append("--dry-run")
        res = subprocess.run(cmd, capture_output=True, text=True)
        print(res.stdout.strip() or res.stderr.strip())
        return res.returncode

def cmd_version(args):
    ver = {
        "name": "MAYOTIX OS",
        "version": "5.0-alpha",
        "cli_version": "1.0.0",
        "ipc_api_version": "2.0",
        "maintainer": "MAYOTIX OS Project"
    }
    if args.json:
        print(json.dumps(ver, indent=2))
    else:
        print(f"MAYOTIX OS Unified CLI v{ver['cli_version']} (System v{ver['version']})")
    return 0

# ==============================================================================
# Argument Parsing
# ==============================================================================

def main():
    common_parser = argparse.ArgumentParser(add_help=False)
    common_parser.add_argument("--json", action="store_true", help="Output results strictly formatted as JSON")
    common_parser.add_argument("--socket", default=DEFAULT_SOCKET_PATH, help="Path to mayotix-daemon Unix domain socket")

    parser = argparse.ArgumentParser(
        prog="mayotix",
        parents=[common_parser],
        description="MAYOTIX OS Unified System Management CLI",
        epilog="Use 'mayotix <command> --help' for details on specific subcommands."
    )

    subparsers = parser.add_subparsers(dest="command", help="Management command to execute")

    # mayotix status
    p_status = subparsers.add_parser("status", parents=[common_parser], help="Display overall system and security posture")
    p_status.set_defaults(func=cmd_status)

    # mayotix security
    p_sec = subparsers.add_parser("security", parents=[common_parser], help="Inspect SELinux mode, policies, and kernel hardening")
    p_sec.set_defaults(func=cmd_security)

    # mayotix network
    p_net = subparsers.add_parser("network", parents=[common_parser], help="Inspect Encrypted DNS, WireGuard VPN, and Tor privacy status")
    p_net.set_defaults(func=cmd_network)

    # mayotix firewall
    p_fw = subparsers.add_parser("firewall", parents=[common_parser], help="Inspect and control nftables fail-closed kill-switch")
    p_fw.add_argument("--enable", action="store_true", help="Atomically enable fail-closed kill-switch")
    p_fw.add_argument("--disable", action="store_true", help="Disable kill-switch and restore default policy")
    p_fw.set_defaults(func=cmd_firewall)

    # mayotix capture
    p_cap = subparsers.add_parser("capture", parents=[common_parser], help="Manage defender live packet captures and security sniffing")
    cap_subparsers = p_cap.add_subparsers(dest="capture_action", help="Capture action to perform")

    p_cap_start = cap_subparsers.add_parser("start", parents=[common_parser], help="Start packet capture session")
    p_cap_start.add_argument("-i", "--interface", help="Target network interface (e.g., wg0, eth0, any)")
    p_cap_start.add_argument("-p", "--profile", default="wireguard-egress", help="Capture profile (wireguard-egress, dot-dns, leak-sniffer, custom)")
    p_cap_start.add_argument("-f", "--filter", help="Custom BPF filter expression")
    p_cap_start.add_argument("-o", "--output", help="Destination pcap file path")
    p_cap_start.add_argument("--dry-run", action="store_true", help="Simulate capture startup without launching daemon")
    p_cap_start.set_defaults(func=cmd_capture)

    p_cap_stop = cap_subparsers.add_parser("stop", parents=[common_parser], help="Stop active packet capture session")
    p_cap_stop.add_argument("--dry-run", action="store_true", help="Simulate capture stop")
    p_cap_stop.set_defaults(func=cmd_capture)

    p_cap_status = cap_subparsers.add_parser("status", parents=[common_parser], help="Display active packet capture status")
    p_cap_status.add_argument("--dry-run", action="store_true", help="Simulate status check")
    p_cap_status.set_defaults(func=cmd_capture)

    p_cap_profiles = cap_subparsers.add_parser("list-profiles", parents=[common_parser], help="List available security capture profiles")
    p_cap_profiles.set_defaults(func=cmd_capture)

    p_cap.set_defaults(func=cmd_capture)

    # mayotix version
    p_ver = subparsers.add_parser("version", parents=[common_parser], help="Display version and release information")
    p_ver.set_defaults(func=cmd_version)

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 0

    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
