    print(f"    - SMEP / SMAP:         {GREEN}{'Enabled' if kh.get('smep_smap') else 'Disabled'}{NC}")
    print(f"    - NX / Stack Guard:    {GREEN}{'Active' if kh.get('nx_bit') else 'Disabled'}{NC}")
    print(f"{BOLD}{CYAN}================================================================{NC}\n")
