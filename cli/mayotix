    data = query_subsystem("security.get", sock_path=args.socket)
    if args.json:
        print(json.dumps(data, indent=2))
        return 0

    print(f"\n{BOLD}{CYAN}================================================================{NC}")
    print(f"{BOLD}{CYAN}               MAYOTIX OS Security Posture                      {NC}")
    print(f"{BOLD}{CYAN}================================================================{NC}")
    sel = data.get("selinux", {})
    print(f"  {BOLD}SELinux Mode:{NC}        {GREEN}{sel.get('mode', 'Unknown')}{NC}")
    print(f"  {BOLD}Recent AVC Denials:{NC}  {GREEN if sel.get('avc_denials_recent', 0) == 0 else RED}{sel.get('avc_denials_recent', 0)}{NC}")
    print(f"  {BOLD}Loaded Modules:{NC}      {len(sel.get('modules_loaded', []))} custom confined domains")
