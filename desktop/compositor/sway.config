# MAYOTIX OS Phase 3 Week 1: Hardened Sway Configuration
# This configuration focuses on security, minimalism, and a dark aesthetic.

# Basic settings
set $mod Mod4   # Super/Windows key
set $term alacritty   # Preferred terminal emulator
set $launcher rofi -show drun   # Application launcher
set $security_center mayotix-security-center   # Security Center GUI

# Font settings
font pango:JetBrains Mono 10

# Colors (dark mode with security accents)
set $background         #1e1e1e
set $statusline         #2a2a2a
set $focused_border     #0099ff
set $unfocused_border   #444444
set $urgent_border      #ff3b30
set $text               #e0e0e0
set $inactive_text      #8a8a8a

# Client colors
client.background               $background
client.focused                  $focused_border
client.unfocused                $unfocused_border
client.urgent                   $urgent_border
client.placeholder              $inactive_text
client.text                     $text
client.inactive                 $inactive_text
client.urgent                   $urgent_border
client.focused_background       $background
client.unfocused_background     $background
client.urgent_background        $urgent_border
client.placeholder_background   $inactive_text

# Borders
pixel 3
smart_borders on
smart_gaps off
gaps inner 5
gaps outer 10

# Bar configuration (using waybar)
bar {
    status_command waybar
    position top
    height 30
    colors {
        background $statusline
        statusline $focused_border
        separator  #666666
        focused_workspace  $bg $focused_border $text
        active_workspace   $bg $unfocused_border $text
        inactive_workspace $bg $inactive_text $inactive_text
        urgent_workspace   $bg $urgent_border $text
        binding_mode       $bg $focused_border $text
    }
}

# Disable unwanted IPC restrictions? Actually we restrict by not exposing unnecessary commands.
# We'll bind only essential keys.

# Keybindings
# Terminal
bindset $mod+Return exec $term
# Launcher
bindset $mod+Space exec $launcher
# Security Center
bindset $mod+Shift+S exec $security_center
# Reload Sway
bindset $mod+Shift+C reload
# Exit Sway
bindset $mod+Shift+E exec swaynag -t warning -m 'Exit sway?' -b 'Yes, exit sway' 'swaymsg exit'

# Window management
bindset $mod+Q kill
bindset $mod+Shift+Q kill
bindset $mod+Left focus left
bindset $mod+Down focus down
bindset $mod+Up focus up
bindset $mod+Right focus right
bindset $mod+Shift+Left move left
bindset $mod+Shift+Down move down
bindset $mod+Shift+Up move up
bindset $mod+Shift+Right move right
bindset $mod+h focus left
bindset $mod+j focus down
bindset $mod+k focus up
bindset $mod+l focus right
bindset $mod+Shift+h move left
bindset $mod+Shift+j move down
bindset $mod+Shift+k move up
bindset $mod+Shift+l move right

# Resize mode
bindset $mod+R resize set width 10 px or height 10 px
# Mode "resize": Left/Dow n/Up/Right resize in that direction
mode "resize" {
    bindset Left resize shrink width 10 px or height 10 px
    bindset Down resize grow height 10 px or width 10 px
    bindset Up resize shrink height 10 px or width 10 px
    bindset Right resize grow height 10 px or width 10 px
    bindset Return mode "default"
    bindset Escape mode "default"
}

# Disable screenshot and screen recording by not binding any keys to those functions.
# If you want to allow screenshots via a secure tool, you can add a keybinding here.
# For now, we leave it unbound.

# Disable clipboard snooping by not providing a clipboard manager.
# If clipboard is needed, we can add a secure clipboard manager later (e.g., wl-clipboard with restrictions).
# For now, we rely on the fact that no clipboard manager is running.

# Startup applications
exec_always --no-startup-id $term -e tmux
exec_always --no-startup-id waybar
exec_always --no-startup-id $security_center &

# Disable unnecessary features
# No need to bind keys for scratchpad, etc.

# Reload on config change (handled by systemd user service)