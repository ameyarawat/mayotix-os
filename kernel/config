# Kernel configuration for MAYOTIX OS
#
# This provides a minimal but secure kernel configuration.
# In Phase 1, we use the host Fedora kernel.
# In Phase 2, we'll customize these options.

# Derived from: Fedora 40 default config with security hardening

# Core kernel
CONFIG_KERNEL_GZIP=y
CONFIG_KERNEL_XZ=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256

# Boot security
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RELOCATABLE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y

# Memory protection
CONFIG_HAVE_HARDENED_USERCOPY_ALLOCATOR=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=y
CONFIG_X86_SMAP=y
CONFIG_X86_SMEP=y

# Stack protection
CONFIG_HAVE_STACKPROTECTOR=y
CONFIG_CC_STACKPROTECTOR_STRONG=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# Control Flow Guard / Return-Oriented Programming protection
CONFIG_CFI_CLANG=y
CONFIG_SHADOW_CALL_STACK=y

# Address Space Layout Randomization
CONFIG_HAVE_ARCH_ASLR=y
CONFIG_HAVE_ARCH_MMAP_RND_BITS=y
CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_HAVE_ARCH_MMAP_RND_COMPAT_BITS=y
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16

# Module signing
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_SIG_ALL=y

# Crypto
CONFIG_HAVE_KERNEL_LZ4=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y

# Filesystem security
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_ENCRYPTION=y

# LUKS/dm-crypt
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y

# SELinux (mandatory)
CONFIG_HAVE_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=1

# AppArmor (optional, secondary to SELinux)
CONFIG_SECURITY_APPARMOR=n

# Audit
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# Network security
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=n

# USB security (prevent autorun)
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_STORAGE_REALTEK=y

# Disable unnecessary modules
CONFIG_LEGACY_PTYS=n
CONFIG_LEGACY_PTY_COUNT=0

# Disable debugfs (security risk)
CONFIG_DEBUG_FS=n

# Enable core dumping for debugging (but disable ptrace_scope for now)
CONFIG_COREDUMP=y

# Disable kexec (prevents replacing kernel at runtime)
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n

# Restrict module loading to signed
CONFIG_MODULE_SIG_FORCE=y
